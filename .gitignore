# =========================
# Hugo build output
# =========================
public/
resources/_gen/
.hugo_build.lock

# Hugo cache
.cache/
.hugo_cache/

# =========================
# Artwork/archive/docs/book-source content (hosted externally, or
# simply unused by the site — nothing under these paths is referenced
# by any template or content file, so none of it should ever be
# committed to this repo or deployed to the site's own server).
# =========================
static/images/artworks/
static/images/archive/
static/images/docs/
static/images/books/

# =========================
# Private files — never publish (this repo is public)
# =========================
Newsletter emails/
*.msg
*.eml
*.pst
static/images/docs/mailing list email templates/
private/

# Old local copy of the theme (backup only — not used by the site)
themes/portfolio-theme-backup-9-13-2026/

# =========================
# Local analytics + scripts (private)
# =========================
logs/

# =========================
# Books (hosted externally, same pattern as artwork/archive images) —
# book-sources/ holds the raw PDFs/GIFs a book was generated from;
# book-images/ holds the processed JPGs ready to upload to the
# louis-andrada-images repo. Neither ships with this site or repo —
# the live site loads book images straight from that GitHub repo
# (see books_image_base in hugo.toml).
# =========================
book-sources/
book-images/

# =========================
# Node / package managers
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# Netlify local build cache
# =========================
.netlify/

# =========================
# Temporary files
# =========================
*.tmp
*.log
# IndexNow submission state (local to this machine)
.indexnow-state.json
# Commit last deployed by npm run deploy (local to this machine)
.last-deploy
