{{- /* Hugo's sitemap, with every page at its one real address (_partials/canonical.html): on
       andrada.one, Artworks pages on louis.andrada.one, Oeuvre on han., Photography on odi., the
       Links page as andrada.one/ itself. Search Console's Domain property covers every subdomain,
       so one sitemap can list them all. noindex pages are left out. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- $seen := dict }}
{{- range where .Pages "Sitemap.Disable" "ne" true }}
  {{- if and .Permalink (not .Params.noindex) }}
    {{- $u := partial "canonical.html" . }}
    {{- if not (index $seen $u) }}
      {{- $seen = merge $seen (dict $u true) }}
  <url>
    <loc>{{ $u }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}
  </url>
    {{- end }}
  {{- end }}
{{- end }}
</urlset>
