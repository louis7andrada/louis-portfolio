{
  "name": "louis-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tailwindcss -i ./themes/portfolio-theme/assets/css/main.css -o ./static/css/output.css --watch",
    "hugo": "hugo server -D",
    "test": "node tests/smoke-test.mjs",
    "test:live": "node tests/live-test.mjs",
    "rev": "concurrently \"npm run dev\" \"npm run hugo\"",
    "rev:test": "concurrently \"npm run dev\" \"npm run hugo\" \"node tests/live-test.mjs --always-pass\"",
    "build": "tailwindcss -i ./themes/portfolio-theme/assets/css/main.css -o ./static/css/output.css --minify && hugo --gc --minify",
    "notify-search-engines": "node scripts/ping-indexnow.mjs",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy-draft": "powershell -Command \"if (Test-Path .\\public) { Remove-Item -Recurse -Force .\\public }; if (Test-Path .\\.hugo_build.lock) { Remove-Item -Force .\\.hugo_build.lock }; npm run build; if ($LASTEXITCODE -eq 0) { netlify deploy --dir=public }\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
